# TokenRouter (OpenAI-compatible gateway). Server-side only — never prefix with NEXT_PUBLIC_.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.io/v1

# Optional: override the gateway model IDs used for each tier (cheapest → strongest).
TOKENROUTER_MODEL_ECONOMY=openai/gpt-5-nano
TOKENROUTER_MODEL_BALANCED=openai/gpt-5-mini
TOKENROUTER_MODEL_PREMIUM=anthropic/claude-sonnet-4-5
